#!/bin/csh -f

set inp = "undefined"
if ($#argv == 1) then
  set inp = $1
endif

if ("$inp" != "-nomodules") then

# Intel compiler + Intel MPI
setenv I_MPI_LIBRARY_KIND debug
source /usr/share/modules/init/csh
# not sure if needed
module use /glob/module-files/intel-oneapi-components
module load -s icc mpi
setenv FOR_DUMP_CORE_FILE 1
setenv I_MPI_DEBUG_COREDUMP 1
setenv I_MPI_DEBUG 4

endif
 
setenv ICE_MACHINE_MACHNAME devcloud
setenv ICE_MACHINE_ENVNAME intel
setenv ICE_MACHINE_MAKE make
setenv ICE_MACHINE_WKDIR ~/cice-dirs/runs/
setenv ICE_MACHINE_INPUTDATA ~/cice-dirs/input/
setenv ICE_MACHINE_BASELINE ~/cice-dirs/baselines/
setenv ICE_MACHINE_SUBMIT qsub
setenv ICE_MACHINE_TPNODE 80 
setenv ICE_MACHINE_ACCT unused
setenv ICE_MACHINE_QUEUE batch
setenv ICE_MACHINE_BLDTHRDS 40
setenv ICE_MACHINE_QSTAT qstat
