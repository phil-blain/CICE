#!/bin/csh -f

set inp = "undefined"
if ($#argv == 1) then
  set inp = $1
endif

if ("$inp" != "-nomodules") then

source /fs/ssm/main/opt/ssmuse/ssmuse-1.11/ssmuse_1.11_all/bin/ssmuse-boot.csh >& /dev/null # package loader
set ssmuse=`which ssmuse-csh`
source $ssmuse -x /fs/ssm/main/opt/intelcomp/inteloneapi-2021.4.0 # Intel compiler + Intel MPI
setenv UCX_NET_DEVICES "mlx5_1:1"
setenv I_MPI_DEBUG_COREDUMP 1
setenv FOR_DUMP_CORE_FILE 1
#setenv I_MPI_HYDRA_TOPOLIB "ipl"
source $ssmuse -x main/opt/hdf5-netcdf4/serial/shared/inteloneapi-2021.3.0/01 # NetCDF

#limit coredumpsize unlimited
#limit stacksize unlimited

endif
 
setenv ICE_MACHINE_MACHNAME hpcr
setenv ICE_MACHINE_ENVNAME intel
setenv ICE_MACHINE_MAKE make
setenv ICE_MACHINE_WKDIR ~/data/site3/cice/runs/
setenv ICE_MACHINE_INPUTDATA /home/ords/cmdd/cmde/sice500/
setenv ICE_MACHINE_BASELINE ~/data/site3/cice/baseline/
setenv ICE_MACHINE_SUBMIT "qsub"
setenv ICE_MACHINE_TPNODE 48
setenv ICE_MACHINE_ACCT P0000000
setenv ICE_MACHINE_QUEUE "debug"
setenv ICE_MACHINE_BLDTHRDS 24
setenv ICE_MACHINE_QSTAT "qstat "
