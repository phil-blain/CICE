#!/bin/csh -f

source /fs/ssm/main/opt/ssmuse/ssmuse-1.7/ssmuse_1.7_all/bin/ssmuse-boot.csh >& /dev/null # package loader
set ssmuse=`which ssmuse-csh`
source $ssmuse -x hpco/exp/intelpsxe-cluster-19.0.3.199 # intel compiler
source $ssmuse -x hpco/exp/openmpi/openmpi-3.1.2--hpcx-2.2.0--ofed-4.4.2--intel-2019.0.045 # openmpi
#source $ssmuse -x hpco/exp/hdf5-netcdf4/serial/static/intel-19.0.3.199/01 # netcdf
setenv HDF5_BASE_DIR /fs/ssm/hpco/exp/hdf5-netcdf4/master/hdf5_1.10.5-intel-19.0.3.199-serial-static_ubuntu-18.04-amd64-64
setenv NETCDF_FORTRAN_BASE_DIR /fs/ssm/hpco/exp/hdf5-netcdf4/master/netcdf-fortran_4.4.5-intel-19.0.3.199-serial-static_ubuntu-18.04-amd64-64
setenv NETCDF_BASE_DIR /fs/ssm/hpco/exp/hdf5-netcdf4/master/netcdf_4.7.0-intel-19.0.3.199-serial-static_ubuntu-18.04-amd64-64 

setenv ICE_MACHINE_ENVNAME hpcr
setenv ICE_MACHINE_COMPILER intel
setenv ICE_MACHINE_MAKE make
setenv ICE_MACHINE_WKDIR ~/cice-dirs/runs 
setenv ICE_MACHINE_INPUTDATA /home/ords/cmdd/cmde/phb001/
setenv ICE_MACHINE_BASELINE ~/cice-dirs/baselines
setenv ICE_MACHINE_SUBMIT "qsub"
setenv ICE_MACHINE_TPNODE 36
setenv ICE_MACHINE_ACCT P0000000
setenv ICE_MACHINE_QUEUE "debug"
setenv ICE_MACHINE_BLDTHRDS 4
setenv ICE_MACHINE_QSTAT "qstat "

if (-e ~/.cice_proj) then
   set account_name = `head -1 ~/.cice_proj`
   setenv CICE_ACCT ${account_name}
endif
